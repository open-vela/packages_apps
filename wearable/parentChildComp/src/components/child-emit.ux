<template>
  <div class="child-container">
    <text class="child-title">子组件1 (Props + $emit)</text>
    <text class="child-info">来自父组件: {{ message }}</text>
    <text class="child-count">子组件计数: {{ localCount }}</text>
    <input type="button" class="child-btn" value="通知父组件 +1" onclick="handleClick" />
  </div>
</template>

<script>
  export default {
    props: {
      message: {
        type: String,
        default: '暂无消息'
      },
      count: {
        type: Number,
        default: 0
      }
    },
    data: {
      localCount: 88
    },
    onInit() {
      this.$watch('count', 'onCountChange')
    },
    onCountChange(newVal) {
      this.localCount = newVal
    },
    handleClick() {
      this.localCount++
      // 通过 $emit 触发父组件绑定的自定义事件
      this.$emit('countChange', { value: this.localCount })
    }
  }
</script>

<style>
  .child-container {
    flex-direction: column;
    align-items: center;
    background-color: #16213e;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 12px;
  }
  .child-title {
    font-size: 22px;
    color: #e94560;
    margin-bottom: 8px;
  }
  .child-info {
    font-size: 20px;
    color: #ffffff;
    margin-bottom: 4px;
  }
  .child-count {
    font-size: 20px;
    color: pink;
    margin-bottom: 8px;
  }
  .child-btn {
    background-color: #e94560;
    color: #ffffff;
    font-size: 22px;
    width:280px;
    height: 36px;
    border-radius: 18px;
  }
</style>
