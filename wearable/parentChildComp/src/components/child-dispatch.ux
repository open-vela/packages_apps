<template>
  <div class="child-container">
    <text class="child-title">子组件2 ($dispatch 向上传递)</text>
    <text class="child-info">子组件2计数:{{inputText}}</text>
    <input
      type="button"
      class="child-input"
      value="点击计数-1"
      @click="subtractionClick"
    />
    <input type="button" class="child-btn" value="dispatch 发送" onclick="handleDispatch" />
  </div>
</template>



<script>
export default {
  data: {
    inputText: 999
  },
  subtractionClick(evt) {
    this.inputText =  this.inputText-1
    console.log("子组件2输入内容: " + this.inputText)
  },
  handleDispatch() {
    if (!this.inputText) return
    // 通过 $dispatch 向上冒泡传递事件，父组件用 $on 监听
    this.$dispatch("dispatchEvt", {
      message: this.inputText
    })
    this.inputText = 999
  }
}
</script>

<style>
.child-container {
  flex-direction: column;
  align-items: center;
  background-color: #16213e;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}
.child-title {
  font-size: 24px;
  color: #53d8fb;
  margin-bottom: 8px;
}
.child-info {
  font-size: 22px;
  color: #ffffff;
  margin-bottom: 4px;
}
.child-input {
  background-color: #0f3460;
  color: #ffffff;
  font-size: 22px;
  height: 36px;
  border-radius: 8px;
  padding: 0 10px;
  margin-bottom: 8px;
  width: 200px;
}
.child-btn {
  background-color: #53d8fb;
  color: #1a1a2e;
  font-size: 22px;
  height: 36px;
  width:280px;
  border-radius: 18px;
}
</style>