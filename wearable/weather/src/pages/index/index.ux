  .Bottom_page {
      width:480px;
      height:480px;
      background-color: #000000;
  }

  .page {
      width: 100%;
      height: 100%;
      background-color: #000000;
      padding: 30px 25px;
      transition: margin-top 0.2s, opacity 0.1s;
  }

  .header {
  margin-bottom: 30px;
  }

  .city {
  font-size: 40px;
  font-weight: 500;
  margin-bottom: 8px;
  }

  .province {
  font-size: 18px;
  color: #888888;
  }

  .column {
  flex-direction: column;
  }

  .row {
  flex-direction: row;
}

.center {
  align-items: center;
  justify-content: center;
  }

  .body {
  flex: 1;
  justify-content: space-around;
  }

  .info {
  height:290px;
  margin-bottom: 30px;
  /* background-color: aqua; */
}

.icon {
  width: 170px;
  height: 170px;
  margin-right: 20px;
}

.temp-info {
  align-items: flex-start;
}

.temp {
  font-size: 55px;
  font-weight: 320;
  line-height: 60px;
}

.weather {
  font-size: 18px;
  color: #cccccc;
  margin-top: 5px;
}

.more-info {
  width: 85%;
  height: 300px;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 15px;
  padding: 0 15px;
}

.value-container {
  flex-direction: row;
  align-items: baseline;
}

.item {
  flex: 1;
}

.value {
  font-size: 40px;
  font-weight: 500;
}

.sub {
  font-size: 20px;
  color: #cccccc;
  margin-left: 2px;
}

.label {
  color: #888888;
  font-size: 20px;
  margin-top: 8px;
}

  /* 底部样式 */
  .footer {
  margin-top: 30px;
}

.update-time {
  color: #666666;
  font-size: 20px;
  margin-bottom: 15px;
}

</style>



