      },
      // 横向滚动的天气列表数据
      weatherList: [
        {
          fxDate: "今天",
          tempLow: "-1",
          tempHigh: "12",
          iconDay: "101"
        },
        {
          fxDate: "明天", 
          tempLow: "0",
          tempHigh: "13",
          iconDay: "101"
        },
        {
          fxDate: "周二",
          tempLow: "0", 
          tempHigh: "13",
          iconDay: "101"
        },
        {
          fxDate: "周三",
          tempLow: "2",
          tempHigh: "15", 
          iconDay: "101"
        },
        {
          fxDate: "周四",
          tempLow: "-2",
          tempHigh: "11",
          iconDay: "101" 
        },
        {
          fxDate: "周五",
          tempLow: "-3",
          tempHigh: "9",
          iconDay: "101"
        },
        {
          fxDate: "周六", 
          tempLow: "1",
          tempHigh: "14",
          iconDay: "101"
        }
      ],
      productList: [
        { name: '衣服', price: '100' },
        { name: '裤子', price: '200' },
        { name: '鞋子', price: '300' },
        { name: '帽子', price: '60' },
        { name: '雨伞', price: '300' },
        { name: '书包', price: '60' },
        { name: '书本', price: '30' }
      ],
    },
  
    onInit() {
      // 页面初始化时获取天气数据
      //this.loadWeatherData()
    },

    onScroll(e) {
      console.log('### list onScroll evt: ', e)
    },
    onScrollTop(e) {
      console.log('### list onScrollTop evt: ', e)
    },
    onScrollBottom(e) {
      console.log('### list onScrollBottom evt: ', e)
    },
    onScrollTouchup(e) {
      console.log('### list onScrollTouchup evt: ', e)
    },
  
    onShow() {
      // 页面显示时刷新数据
      console.log('天气主页显示')
    },
  
    loadWeatherData() {
      // 这里可以调用天气API获取数据
      // 暂时使用静态数据
      console.log('加载天气数据')
    },
  
    onTouchStart(event) {
      this.touchStartY = event.touches[0].clientY
    },
  
    onTouchMove(event) {
      // 防止页面滚动
      // event.preventDefault()
    },
  
    onTouchEnd(event) {
      this.touchEndY = event.changedTouches[0].clientY
      this.handleSwipe()
    },
  
    handleSwipe() {
      const deltaY = this.touchStartY - this.touchEndY
      const minSwipeDistance = 50 // 最小滑动距离
  
      if (deltaY < -minSwipeDistance) {
        // 向上滑动，跳转到预报页面
        this.navigateToForecast()
      }
    },
  
    navigateToForecast() {
      if (this.isTransitioning) return;
      this.isTransitioning = true;

      router.replace({
        uri: '/pages/test',
        params: {
          city: this.city,
          province: this.province,
          country: this.country
        },
        // 核心：在这里直接定义转场动画
        transition: {
          type: 'slide',     // 动画类型，'slide', 'fade', 'none'
          duration: 300,     // 持续时间
          direction: 'down',    // 滑动方向，'left', 'right', 'up', 'down'
          // 还可以配置插值器等，具体请查阅快应用官方文档
          ease: 'cubic-bezier(0.25, 0.8, 0.25, 1)' 
        }
      });
      setTimeout(() => {
        this.isTransitioning = false;
      }, 500); // 500ms 足够完成转场
    }

  }
</script>

