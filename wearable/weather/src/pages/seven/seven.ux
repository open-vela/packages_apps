<template>
  <div class="Bottom_page">

    <div class="page column" ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd" style="{{'margin-top:' + translateY + 'px; opacity:' + opacity }}">
        <div class="header column center">
            <text class="city">{{city}}</text>
            <text class="province">{{province}}/{{country}}</text>
        </div>
        <div class="body column center">
  
            <div class="info column center">
              <text class="title">未来七天预报</text>
              <text class="summary">最高温8° 最低温-6°</text>
            </div>

            <div class="scroll-container">
              <scroll class="box" scroll-x="true" style="scroll-snap-type: x proximity;" bounces="true">
                <div class="scroll-item column center" for="{{weatherList}}">
                  <text class="date">{{$item.fxDate}}</text>
                  <image class="icon" src="/common/icon/weather/{{$item.iconDay}}.png"></image>
                  <text class="temp">{{$item.tempLow}}°~{{$item.tempHigh}}°</text>
                </div>
              </scroll>
            </div>

            <div class="footer">
              <text class="update-time">数据更新于12-20 09:15</text>
            </div>
        </div>
    </div>
  </div>
</template>

<script>

  import TouchHelper, {resetPagePosition} from '../../common/utils/common'
  const router = require('@system.router')
  
  export default {
    data: {
      touchStartY: 0,
      touchEndY: 0,
      opacity: 0,
      translateY: 600,
      city: '西安市',
      province: '陕西省',
      country: '中国',
      weather: {
        obsTime: "12-21 09:05",
        temp: "13",
        feelsLike: "10",
        icon: "101",
        text: "多云",
        humidity: "72",
        vis: "16"
      },
      // 横向滚动的天气列表数据
      weatherList: [
        {
          fxDate: "今天",
          tempLow: "-1",
          tempHigh: "12",
          iconDay: "101"
        },
        {
          fxDate: "明天", 
          tempLow: "0",
          tempHigh: "13",
          iconDay: "102"
        },
        {
          fxDate: "周二",
          tempLow: "0", 
          tempHigh: "13",
          iconDay: "103"
        },
        {
          fxDate: "周三",
          tempLow: "2",
          tempHigh: "15", 
          iconDay: "104"
        },
        {
          fxDate: "周四",
          tempLow: "-2",
          tempHigh: "11",
          iconDay: "150" 
        },
        {
          fxDate: "周五",
          tempLow: "-3",
          tempHigh: "9",
          iconDay: "300"
        },
        {
          fxDate: "周六", 
          tempLow: "1",
          tempHigh: "14",
          iconDay: "301"
        }
      ],
    
    },
  

    onScroll(e) {
      console.log('### list onScroll evt: ', e)
    },
    onScrollTop(e) {
      console.log('### list onScrollTop evt: ', e)
    },
    onScrollBottom(e) {
      console.log('### list onScrollBottom evt: ', e)
    },
    onScrollTouchup(e) {
      console.log('### list onScrollTouchup evt: ', e)
    },
  
    onShow() {
      // 页面显示时刷新数据
      console.log('天气主页显示')
      setTimeout(() => {
        this.translateY = 0
        this.opacity = 1
      }, 50)
    },
  
    onTouchStart(event) {
        TouchHelper.onTouchStart(event, this)
    },

    onTouchMove(event) {
        TouchHelper.onTouchMove(event, this)
    },

    onTouchEnd(event) {
        const direction = TouchHelper.onTouchEnd(event, this)
        if (direction === -1) {
            console.log('上滑了，可以切换页面')
            this.navigateToForecast()
        } else {
            console.log('滑动不足，取消切换')
            resetPagePosition(this)
        }
    },
  
    
    navigateToForecast() {
      router.replace({
        uri: '/pages/index',
        params: {
          city: this.city,
          province: this.province,
          country: this.country
        }
      })
    }

  }
</script>

