  font-weight: bold;
  font-size: 36px;
}

.h2 {
  margin-top: 15px;
  font-size: 30px;
}

.header {
  align-items: center;
  margin-top: 0;
  margin-bottom: 0;
}

.arrow {
  width: 20px;
  height: 20px;
  margin-top: 7px;
  margin-right: 3px;
}

.link {
  height: 40px;
  margin-left: 23px;
  text-overflow: ellipsis;
  font-size: 30px;
  margin: 5px 0;
}

text {
  font-size: 30px;
  margin: 5px 0;
}

@media (shape: pill-shaped) {
  .home-page {
    padding: 60px 10px;
  }

  .link {
    height: 70px;
    margin-left: 15px;
  }

  .h1 {
    font-size: 52px;
  }

  text {
    font-size: 48px;
  }

  .arrow {
    width: 30px;
    height: 36px;
  }
}
</style>
