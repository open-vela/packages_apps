<template>
  <div class="page home-page">
    <block for="{{tabs}}">
      <div class="chapter">
        <text class="h1">{{$item.name}}</text>
        <block for="{{$item.groupList}}">
          <div class="header" @click="toggleGroup($item.name)">
            <image class="arrow" src="/Common/arrow-{{expandedGroups[$item.name] ? 1 : 0}}.png"></image>
            <text class="h2">{{$item.name}}</text>
          </div>
          <block if="{{expandedGroups[$item.name]}}">
            <text class="link" for="{{$item.caseList}}" @click="route($item.path)">{{$item.name}}</text>
          </block>
        </block>
      </div>
    </block>
  </div>
</template>

<script>
import router from '@system.router'
import { tabsData } from './data.js'

export default {
  private: {
    tabs: [tabsData.framework, tabsData.component, tabsData.interface],
    expandedGroups: {}
  },

  route(uri) {
    router.push({ uri })
  },

  toggleGroup(name) {
    this.expandedGroups[name] = !this.expandedGroups[name]
  }
}
</script>

<style>
