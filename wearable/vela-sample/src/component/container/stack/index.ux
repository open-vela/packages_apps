.stack-box {
  width: 250px;
  height: 250px;
}

.box {
  border-radius: 8px;
}

.box1 {
  width: 250px;
  height: 250px;
  background-color: #ff6b6b;
}

.box2 {
  width: 180px;
  height: 180px;
  left: 20px;
  top: 20px;
  background-color: #51cf66;
}

.box3 {
  width: 110px;
  height: 110px;
  left: 50px;
  top: 50px;
  background-color: #339af0;
}

.stack-sm {
  width: 200px;
  height: 100px;
  margin-top: 5px;
  border: 1px solid #ccc;
}

.bg-layer {
  width: 200px;
  height: 100px;
  background-color: #f0f0f0;
}

.fg-layer {
  width: 80px;
  height: 50px;
  background-color: #0faeff;
  border-radius: 5px;
}

.btn-sm {
  height: 50px;
  width: 100px;
  text-align: center;
  border-radius: 5px;
  margin: 5px;
  color: #ffffff;
  font-size: 26px;
  background-color: #0faeff;
}
</style>
