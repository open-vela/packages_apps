@import '../../../style/comm.css';

.btn-sm {
  height: 50px;
  width: 100px;
  text-align: center;
  border-radius: 5px;
  margin: 5px;
  color: #ffffff;
  font-size: 26px;
  background-color: #0faeff;
}
