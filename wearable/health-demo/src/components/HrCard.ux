@import './card.css';

.hd {
  width: 6px;
  height: 1px;
  background-color: #7a4c50;
}
.vd {
  width: 1px;
  height: 6px;
  background-color: #6a3c40;
}
.ylab {
  font-size: 16px;
  color: #b98a8e;
  text-align: left;
}
.xlab {
  font-size: 16px;
  color: #b98a8e;
}

.numrow {
  flex-direction: row;
  align-items: center;
  width: 480px;
  margin-top: 8px;
}
.numhalf {
  flex-direction: row;
  justify-content: flex-end;
  width: 250px;
}
.bpm {
  font-size: 78px;
  color: #ffffff;
  font-weight: bold;
}
.unithalf {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  width: 214px;
  margin-left: 16px;
}
.heart {
  font-size: 28px;
  color: #ff263c;
}
.unit {
  font-size: 22px;
  color: #c9cdd2;
  margin-top: 4px;
}
.zone {
  font-size: 30px;
  margin-top: 6px;
}
</style>
